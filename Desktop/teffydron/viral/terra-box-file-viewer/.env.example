# Database
DATABASE_URL="./local.db"
VIDEO_CACHE_DIR="./video-cache"
VPS_LIBRARY_DIR="./vps-library"

# TeraBox Authentication
# Get the ndus cookie from TeraBox:
# 1. Log in to https://www.terabox.com
# 2. Open browser DevTools (F12)
# 3. Go to Application > Cookies > https://www.terabox.com
# 4. Find the 'ndus' cookie and copy its value
# 5. Paste the value here (without 'ndus=' prefix, or with it)
TERABOX_NDUS="your_ndus_cookie_value_here"

# Better Auth Configuration
# Set the base URL for authentication (required for email links, OAuth callbacks, etc.)
# In development, defaults to http://localhost:3001
# In production on VPS with HTTP, set to: http://TU_IP:3000
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your_random_secret_here_min_32_chars"

# Public URL for the auth client (browser). Must match BETTER_AUTH_URL.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Hostname and port for the VPS (used as fallback when BETTER_AUTH_URL is not set)
HOSTNAME="127.0.0.1"
PORT="3000"

# Email configuration for password reset (optional for hobby use)
# If not set, password reset emails will not be sent but the flow will still work locally.
EMAIL_SERVER_FROM="noreply@tu-dominio.com"
EMAIL_SERVER_HOST="smtp.tu-dominio.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="tu-usuario"
EMAIL_SERVER_PASSWORD="tu-password"

# DeepL Translation API (optional — https://www.deepl.com/pro-api free tier)
# Without this key, news will show in their original language without translation
DEEPL_API_KEY="your_deepl_api_key_here"

# Vercel Configuration (optional, for Vercel deployment)
# VERCEL_URL="your-vercel-url"
# VERCEL_PROJECT_PRODUCTION_URL="your-production-domain"

# V0 Runtime Configuration (optional, for v0.dev)
# V0_RUNTIME_URL="your-v0-runtime-url"
# V0_DEV_APP_URL="your-v0-dev-app-url"
# V0_BUILD_URL="your-v0-build-url"
# V0_SANDBOX_URL="your-v0-sandbox-url"

# News revalidation secret — protects /api/revalidate-news from unauthorized calls
# Used automatically by Vercel Cron. For manual calls: /api/revalidate-news?secret=...
REVALIDATE_SECRET="your_random_secret_here"
